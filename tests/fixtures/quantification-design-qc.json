        "standard_multiplier": 0.6
      },
      "assumptions": [
        "Same added internal-standard amount",
        "A shared response multiplier is stipulated",
        "No absolute concentration follows from the ratio alone"
      ]
    },
    {
      "id": "loq_dilution_scale",
      "kind": "dilution_limit",
      "input": {
