      "expected": {
        "mean": 100.0,
        "sample_sd": 10.0,
        "cv_percent": 10.0
      },
      "assumptions": [
        "Positive ratio-scale response",
        "Descriptive example, not a universal acceptance threshold"
      ]
    },
    {
