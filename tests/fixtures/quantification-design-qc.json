    },
    {
      "id": "linear_drift_interpolation",
      "kind": "drift",
      "input": {
        "qc_positions": [
          1,
          11
        ],
        "qc_responses": [
          100,
          80
        ],
        "sample_position": 6,
        "sample_response": 72,
        "reference_response": 100
      },
      "expected": {
        "predicted_qc_response": 90.0,
        "corrected_response": 80.0
      },
      "assumptions": [
        "Independent evidence stipulates linear multiplicative drift over the interval",
        "Two endpoints alone do not establish linearity",
        "This is not a QC-frequency recommendation or concentration calibration"
      ]
    },
    {
      "id": "median_scaling_ambiguity",
      "kind": "median_scaling",
      "input": {
        "sample_a": [
          10,
          20,
          30,
          40
        ],
        "sample_b": [
          20,
          40,
          60,
          80
        ]
      },
      "expected": {
        "median_a": 25.0,
        "median_b": 50.0,
        "factor": 0.5,
        "scaled_b": [
          10,
          20,
          30,
          40
        ],
        "raw_ratios": [
          2,
          2,
          2,
          2
        ],
        "scaled_ratios": [
          1,
          1,
          1,
          1
        ]
      },
      "assumptions": [
        "Values are positive constructed responses on a fixed sample denominator",
        "The same arithmetic removes a technical multiplier or a genuine global biological change",
        "No explanation can be inferred from the arrays alone"
      ]
    },
    {
      "id": "sample_cv",
      "kind": "cv",
      "input": {
        "qc_responses": [
          90,
