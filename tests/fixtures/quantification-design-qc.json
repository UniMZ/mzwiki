      },
      "expected": {
        "mean_ng_ml": 9.0,
        "mean_minus_reference_ng_ml": -1.0,
        "relative_difference_percent": -10.0
      },
      "assumptions": [
        "Constructed values show repeated agreement need not imply closeness to the reference"
      ]
    },
    {
      "id": "replicate_hierarchy",
      "kind": "replicates",
      "input": {
        "donors": 8,
        "preparations_per_donor": 2,
        "injections_per_preparation": 3
      },
      "expected": {
        "preparations": 16,
        "injections": 48,
        "donor_level_units": 8
      },
      "assumptions": [
        "Eight donors are independently sampled",
        "Higher-level intervention assignments can change the number of experimental units",
        "Repeat preparations and injections are not new donors"
      ]
    },
    {
