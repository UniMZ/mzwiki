  "status": "Constructed educational examples, not experimental results, validated assay procedures, or regulatory advice",
  "arithmetic": "Calculate before rounding. Sample SD uses n-1. Rank checks use exact rational arithmetic.",
  "cases": [
    {
      "id": "linear_calibration_inversion",
      "kind": "calibration",
      "input": {
        "concentrations_ng_ml": [
          1,
          2,
          5,
          10
        ],
        "slope_ml_ng": 0.05,
        "intercept": 0.02,
        "unknown_response": 0.32,
        "dilution_factor": 5
      },
      "expected": {
        "responses": [
          0.07,
          0.12,
          0.27,
          0.52
        ],
        "measured_solution_ng_ml": 6.0,
        "original_sample_ng_ml": 30.0,
        "zero_intercept_ng_ml": 6.4,
        "zero_intercept_relative_error_percent": 6.666666666666667
      },
      "assumptions": [
        "The concentration-response relationship is stipulated, not fitted from experimental data",
        "Supported measured-solution interval is 1–10 ng/mL",
        "Fivefold dilution is separately validated",
        "The four table rows illustrate an equation and do not validate a real assay"
      ]
    },
    {
      "id": "linear_lower_limit_estimates",
      "kind": "lower_limits",
      "input": {
        "response_sd": 0.003,
        "slope_ml_ng": 0.05,
        "dl_multiplier": 3.3,
        "ql_multiplier": 10
      },
      "expected": {
        "dl_ng_ml": 0.198,
        "ql_ng_ml": 0.6
      },
      "assumptions": [
        "Illustrates ICH Q2(R2) linear-response estimates with an appropriate response standard deviation",
        "Not new validated limits for the earlier 1–10 ng/mL calibration example",
        "Does not infer exact detection error probabilities"
      ]
    },
    {
      "id": "precision_and_reference_difference",
      "kind": "reference_difference",
      "input": {
        "reference_ng_ml": 10.0,
        "measurements_ng_ml": [
          9.0,
          9.1,
          8.9
