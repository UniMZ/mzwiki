        "No other identifying information"
      ]
    },
    {
      "id": "paired_estimands",
      "kind": "paired_changes",
      "input": {
        "before": [
          10,
          100,
          1000
        ],
        "after": [
          20,
          200,
          2000
        ]
      },
      "expected": {
        "ratios": [
