        "columns": 4,
        "rank": 4
      },
      "assumptions": [
        "Additive model intercept + condition + indicator(B) + indicator(C)",
        "Constructed allocation is not a power recommendation or claim that interactions vanish"
      ]
    },
    {
      "id": "confounded_design_rank",
      "kind": "matrix_rank",
      "input": {
        "condition": [
